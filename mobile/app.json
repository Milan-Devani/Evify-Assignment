{
  "expo": {
    "name": "Evify Mobile",
    "slug": "evify-mobile",
    "version": "1.0.0",
    "orientation": "portrait",  
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#064E3B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evify.mobile"
    },
    "android": {
      "package": "com.evify.mobile",
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./networkSecurityConfig.xml",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064E3B"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3c42ce74-605f-42c9-8bce-5b6f00d3a602"
      }
    }
  }
}