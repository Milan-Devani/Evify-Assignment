# ==========================================================
# Evify Monorepo .gitignore (Backend, Frontend, Mobile)
# ==========================================================

# ----------------------------------------------------------
# 1. Node.js & Dependencies (Strictly ignore all node_modules)
# ----------------------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ----------------------------------------------------------
# 2. Environment Variables (Tracked for Interview Assignment)
# ----------------------------------------------------------
# Note: .env files are intentionally tracked for easy reviewer setup


# ----------------------------------------------------------
# 3. Expo & React Native Build Artifacts
# ----------------------------------------------------------
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
web-build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/*.xcworkspace
*.orig.*

# ----------------------------------------------------------
# 4. Web & Backend Build Outputs
# ----------------------------------------------------------
dist/
**/dist/
build/
**/build/
frontend/build/
.serverless/
**/.serverless/

# ----------------------------------------------------------
# 5. Logs & Temporary Files
# ----------------------------------------------------------
logs/
**/logs/
*.log

# ----------------------------------------------------------
# 6. Testing & Coverage
# ----------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# ----------------------------------------------------------
# 7. IDE & Editor Specific
# ----------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.eslintcache

# ----------------------------------------------------------
# 8. OS Generated Files
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
